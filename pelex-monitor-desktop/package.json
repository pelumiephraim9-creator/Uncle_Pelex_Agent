{
  "name": "pelex-business-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "User-controlled local business transaction monitor for macOS and Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "dependencies": {
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "tech.pelex.businessmonitor",
    "productName": "Pelex Business Monitor",
    "asar": true,
    "files": ["main.js", "preload.js", "security.js", "index.html", "renderer.js", "styles.css", "package.json", "node_modules/tesseract.js/**/*", "node_modules/@tesseract.js/**/*"],
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.business" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
